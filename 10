2. shortest job first program
def s(at, bt):
  n, t, rt, w, ta, c = len(at), 0, list(bt), [0] * len(at), [0] * len(at), [0] * len(at)
  for _ in range(sum(bt)):
    av = [i for i in range(n) if at[i] <= t and rt[i] > 0]
    if av:
      i = min(av, key=lambda x: rt[x])
      rt[i] -= 1
      c[i] = t + 1 if rt[i] == 0 else c[i]
    t += 1
  for i in range(n):
    ta[i], w[i] = c[i] - at[i], c[i] - at[i] - bt[i]
    print(i + 1, bt[i], at[i], c[i], ta[i], w[i])
  print(sum(w) / n, sum(ta) / n)

s([0, 1, 2, 3], [8, 4, 9, 5])
3.First come first serve program
def fcfs(bt):
    n = len(bt)
    wt = [0] * n
    tat = [0] * n
    for i in range(1, n):
        wt[i] = bt[i - 1] + wt[i - 1]
    for i in range(n):
        tat[i] = bt[i] + wt[i]
    print("P\tBT\tWT\tTAT")
    for i in range(n):
        print(f"{i+1}\t{bt[i]}\t{wt[i]}\t{tat[i]}")
    print("Avg WT =", sum(wt) / n)
    print("Avg TAT =", sum(tat) / n)

fcfs([24, 3, 3])

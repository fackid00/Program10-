10.Inter Process Communication program
from multiprocessing import Pipe, Process

def sender(c):
  c.send("Hello from sender")
def receiver(c):
  print("Received:", c.recv())

if __name__ == "__main__":
  p, c = Pipe()
  p1 = Process(target=sender, args=(c,))
  p2 = Process(target=receiver, args=(p,))
  p1.start()
  p2.start()
  p1.join()
  p2.join()

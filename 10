5.Reader/writer semaphore program
import threading, time
m, w = threading.Semaphore(1), threading.Semaphore(1)
r = 0

def reader():
    global r
    while True:
        with m:
            r += 1
            if r == 1:
                w.acquire()
        print(f"Reader {r} is reading")
        with m:
            r -= 1
            if r == 0:
                w.release()
        time.sleep(3)

def writer():
    while True:
        with w:
            print("Writing data")
            print("_"*20)
        time.sleep(3)

for i in range(4):
    threading.Thread(target=reader).start()
for i in range(2):
    threading.Thread(target=writer).start()
7.First In First Out Program
from queue import Queue

def pageFaults(pages, c):
    q, s, f = Queue(), set(), 0
    for p in pages:
        if p not in s:
            f += 1
            if len(s) == c:
                s.remove(q.get())
            s.add(p)
            q.put(p)
        print(s, "Faults:", f)
    return f

pages = [3,2,1,0,3,2,4,3,2,1,0,4]
print("Total Page Faults:", pageFaults(pages, 3))
